    {
        "id": "d54c0f1f00000021",
        "type": "function",
        "name": "LED / rumble",
        "func": "const b = msg.payload.buttons;\nconst a = msg.payload.analog;\n\nlet led = { r: 0, g: 0, b: 64 };\nif (b.cross) led = { r: 0, g: 0, b: 255 };\nelse if (b.circle) led = { r: 255, g: 0, b: 0 };\nelse if (b.triangle) led = { r: 0, g: 255, b: 0 };\nelse if (b.square) led = { r: 255, g: 0, b: 255 };\n\nmsg.payload = {\n    led,\n    rumble: { small: a.l2_value, large: a.r2_value }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "_mcu": {
            "mcu": true
        },
